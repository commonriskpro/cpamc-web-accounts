{
  "manifest_version": 3,
  "name": "CPAMC Web Accounts",
  "version": "0.2.0",
  "minimum_chrome_version": "106",
  "description": "Añade cuentas web al CPAMC abierto en la pestaña actual.",
  "action": {
    "default_title": "Conectar cuentas web"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "optional_permissions": [
    "cookies",
    "scripting"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://[::1]/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["panel.html", "panel.css", "panel.js", "core.js"],
      "matches": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*", "http://[::1]/*"]
    }
  ]
}
